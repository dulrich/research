+/// List-variant switch (environment variable `SLOS_LISTS`, read once): `committed` (default), `ordered`,
+/// `committed+short`, `ordered+short`. `ordered` sorts every sampled list shortest first (stable, by
+/// character count); `+short` adds host `a` and query key `rEf` (appended for `committed+short`, sorted in
+/// for `ordered+short`). An unknown value aborts the run.
+fn list_variant() -> &'static str {
+    static V: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    V.get_or_init(|| {
+        let v = std::env::var("SLOS_LISTS").unwrap_or_else(|_| "committed".into());
+        if !["committed", "ordered", "committed+short", "ordered+short"].contains(&v.as_str()) {
+            panic!("SLOS_LISTS must be committed, ordered, committed+short or ordered+short, got {v:?}");
+        }
+        v
+    })
+}
+
+/// The sampled list for the active variant; `extra` is the content added by the `+short` variants.
+fn variant_list(base: &[&'static str], extra: &[&'static str]) -> Vec<&'static str> {
+    let v = list_variant();
+    let mut l: Vec<&'static str> = base.to_vec();
+    if v.ends_with("+short") {
+        l.extend_from_slice(extra);
+    }
+    if v.starts_with("ordered") {
+        l.sort_by_key(|s| s.chars().count());
+    }
+    l
+}
