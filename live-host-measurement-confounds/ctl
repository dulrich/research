#!/bin/sh
# ctl - live-host condition controller for the measurement-confounds experiment.
# usage: ctl apply <I0|I1|I2|I3> <L0|L1|L2|L3|L4> [--perf] | restore | readback [--expect restored|I0..I3] | abort | status | dropcache
# >>> shguard modes=exec (generated by shell-disposition-gate --guard; do not edit)
case $(realpath -- "$0" 2>/dev/null) in */'live-host-measurement-confounds/ctl') _shguard_m='exec' ;; *) if [ "${SHGUARD_MODE-}" = 'pipe' ]; then _shguard_m='pipe'; else _shguard_m='source'; fi ;; esac
# shellcheck disable=SC2317
case $_shguard_m in
  exec) unset _shguard_m ;;
  *) printf '%s: refusing %s invocation (supports: exec; pipe callers set SHGUARD_MODE=pipe)\n' 'ctl' "$_shguard_m" >&2; unset _shguard_m; return 1 2>/dev/null || exit 1 ;;
esac
# <<< shguard
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  echo "usage: ctl apply <I0|I1|I2|I3> <L0|L1|L2|L3|L4> [--perf]"
  echo "       ctl restore | readback [--expect restored|I0|I1|I2|I3] | abort | status | dropcache"
  echo "       ctl --help | --build | --version"
  echo ""
  echo "apply     apply an isolation level (I0 none, I1 pinned by the workload only, I2 user/system/init slices"
  echo "          fenced to CCD0 and a measurement slice on CCD1, I3 = I2 + EPP performance on CCD1 + boost off)"
  echo "          and start a load (L0 none, L1 cpu, L2 llc+bandwidth, L3 memory pressure, L4 disk writes; all on CCD0)."
  echo "          --perf also sets perf_event_paranoid=2. The first apply records the pre-state."
  echo "restore   stop antagonists, restore the recorded pre-state (defaults if none)"
  echo "readback  print the current controls; --expect checks them and exits 1 on a mismatch"
  echo "abort     touch the abort flag (the guard stops everything) and restore at once"
  echo "status    print guard/abort flags"
  echo "dropcache evict the whole page cache (an operation, never restored; needs LHMC_AFK=1)"
  echo "Root controls go through a short-lived privileged container (nsenter into PID 1 namespaces)."
  echo "Env: LHMC_STATE (state dir, default var/ctl beside this script), LHMC_STRESS_IMAGE (default lhmc-stress)."
  exit 0
fi
set -eu


HERE=$(cd "$(dirname "$0")" && pwd)
STATE=${LHMC_STATE:-$HERE/var/ctl}
IMG=${LHMC_STRESS_IMAGE:-lhmc-stress}
ROOTIMG=debian:trixie-slim
CCD0="0-5,12-17"
CCD1="6-11,18-23"
UNITS="user.slice system.slice init.scope"

build_id() {
  d=$(git --no-optional-locks -C "$HERE" rev-parse --show-toplevel 2>/dev/null) || d=
  [ -n "$d" ] || { echo unknown; return; }
  sha=$(git --no-optional-locks -C "$d" log -1 --format=%H -- "$d" 2>/dev/null) || sha=
  [ -n "$sha" ] || { echo unknown; return; }
  if [ -n "$(git --no-optional-locks -C "$d" status --porcelain --untracked-files=no -- "$d" 2>/dev/null)" ]; then echo "$sha-dirty"; else echo "$sha"; fi
}

log() { mkdir -p "$STATE"; printf '%s %s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$*" >>"$STATE/ctl.log"; }

# run a script (stdin) as root in the host namespaces
rootsh() { docker run --rm -i --privileged --pid=host -v /sys:/sys "$ROOTIMG" nsenter -t 1 -m -u -i -n -p -- sh -s; }

cpulist() { # expand "0-5,12-17" to words
  echo "$1" | tr ',' '\n' | while IFS=- read -r a b; do seq "$a" "${b:-$a}"; done
}

mem_avail_kb() { awk '/^MemAvailable:/{print $2}' /proc/meminfo; }
mem_full_avg10() { awk '/^full/{sub("avg10=","",$2); print $2}' /proc/pressure/memory; }

save_pre() {
  [ -e "$STATE/pre.env" ] && return 0
  mkdir -p "$STATE"
  {
    for u in $UNITS; do echo "allowed.$u=$(systemctl show "$u" -p AllowedCPUs --value 2>/dev/null || true)"; done
    for n in $(seq 0 23); do echo "epp.$n=$(cat /sys/devices/system/cpu/cpu$n/cpufreq/energy_performance_preference 2>/dev/null || echo balance_performance)"; done
    echo "boost=$(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || echo 1)"
    echo "paranoid=$(cat /proc/sys/kernel/perf_event_paranoid)"
  } >"$STATE/pre.env"
  log "pre-state recorded: $(tr '\n' ' ' <"$STATE/pre.env")"
}

pre() { # pre <key> <default>
  v=$(sed -n "s/^$1=//p" "$STATE/pre.env" 2>/dev/null | head -n 1) || v=
  if [ -n "$v" ] || grep -q "^$1=" "$STATE/pre.env" 2>/dev/null; then echo "$v"; else echo "$2"; fi
}

stop_loads() {
  ids=$(docker ps -aq --filter label=lhmc=load 2>/dev/null || true)
  [ -z "$ids" ] || docker rm -f $ids >/dev/null 2>&1 || true
  rm -rf "$HERE/var/hdd" 2>/dev/null || true
  if [ -f "$STATE/guard.pid" ]; then
    gp=$(cat "$STATE/guard.pid")
    [ "$gp" = "${LHMC_GUARD_SELF:-}" ] || kill "$gp" 2>/dev/null || true
    rm -f "$STATE/guard.pid"
  fi
}

do_restore() {
  log "restore begin"
  stop_loads
  allowed=""
  for u in $UNITS; do allowed="$allowed $u=$(pre "allowed.$u" "")"; done
  {
    for a in $allowed; do
      u=${a%%=*}; v=${a#*=}
      echo "systemctl set-property --runtime $u AllowedCPUs=$v || echo \"restore failed: $u\" >&2"
    done
    echo "systemctl set-property --runtime lhmc.slice AllowedCPUs= 2>/dev/null || true"
    echo "systemctl stop lhmc.slice 2>/dev/null || true"
    for n in $(seq 0 23); do
      echo "echo $(pre "epp.$n" balance_performance) > /sys/devices/system/cpu/cpu$n/cpufreq/energy_performance_preference"
    done
    echo "echo $(pre boost 1) > /sys/devices/system/cpu/cpufreq/boost"
    echo "echo $(pre paranoid 3) > /proc/sys/kernel/perf_event_paranoid"
  } | rootsh
  rm -f "$STATE/pre.env"
  log "restore done"
}

start_load() {
  mkdir -p "$STATE"
  base="docker run -d --label lhmc=load --cpuset-cpus $CCD0"
  case $1 in
    L0) return 0 ;;
    L1) $base --name lhmc-load-cpu "$IMG" stress-ng --cpu 12 --cpu-method matrixprod --timeout 86400 >/dev/null ;;
    L2) $base --name lhmc-load-mem "$IMG" stress-ng --stream 8 --cache 4 --timeout 86400 >/dev/null ;;
    L3)
      avail=$(mem_avail_kb)
      bytes=$(( (avail - 8 * 1024 * 1024) * 1024 / 4 ))
      [ "$bytes" -gt 0 ] || { echo "ctl: L3 refused, MemAvailable ${avail} kB leaves no headroom above 8 GB" >&2; return 1; }
      $base --name lhmc-load-vm "$IMG" stress-ng --vm 4 --vm-bytes "$bytes" --vm-keep --timeout 86400 >/dev/null ;;
    L4)
      mkdir -p "$HERE/var/hdd"
      $base -v "$HERE/var/hdd:/w" --name lhmc-load-hdd "$IMG" stress-ng --hdd 4 --hdd-opts wr-seq,fsync --hdd-bytes 1g --temp-path /w --timeout 86400 >/dev/null ;;
    *) echo "ctl: unknown load $1" >&2; return 2 ;;
  esac
}

do_apply() {
  iso=$1; load=$2; perf=${3:-}
  case $iso in I0|I1|I2|I3) ;; *) echo "ctl: unknown isolation $iso" >&2; exit 2 ;; esac
  case $load in L0|L1|L2|L3|L4) ;; *) echo "ctl: unknown load $load" >&2; exit 2 ;; esac
  case $perf in ""|--perf) ;; *) echo "ctl: unknown option $perf" >&2; exit 2 ;; esac
  rm -f "$STATE/guard-tripped" "$STATE/abort"
  save_pre
  log "apply $iso $load $perf"
  trap 'log "apply failed, restoring"; do_restore; exit 1' INT TERM
  {
    [ "$perf" != "--perf" ] || echo "echo 2 > /proc/sys/kernel/perf_event_paranoid"
    case $iso in
      I2|I3)
        echo "systemctl start lhmc.slice"
        echo "systemctl set-property --runtime lhmc.slice AllowedCPUs=$CCD1"
        for u in $UNITS; do echo "systemctl set-property --runtime $u AllowedCPUs=$CCD0"; done ;;
    esac
    case $iso in
      I3)
        for n in $(cpulist "$CCD1"); do echo "echo performance > /sys/devices/system/cpu/cpu$n/cpufreq/energy_performance_preference"; done
        echo "echo 0 > /sys/devices/system/cpu/cpufreq/boost" ;;
    esac
    echo true
  } | rootsh || { log "apply: root step failed"; do_restore; exit 1; }
  if [ "$load" != L0 ]; then
    start_load "$load" || { do_restore; exit 1; }
    ( setsid "$0" guard </dev/null >>"$STATE/guard.log" 2>&1 & echo $! >"$STATE/guard.pid" )
  fi
  trap - INT TERM
}

do_guard() {
  echo "$$" >"$STATE/guard.pid"
  LHMC_GUARD_SELF=$$
  export LHMC_GUARD_SELF
  while :; do
    why=
    [ ! -e "$STATE/abort" ] || why="abort flag"
    [ -n "$why" ] || { a=$(mem_avail_kb); [ "$a" -ge 4194304 ] || why="MemAvailable $a kB < 4 GB"; }
    [ -n "$why" ] || { f=$(mem_full_avg10); awk -v f="$f" 'BEGIN{exit !(f>5)}' && why="memory full avg10 $f > 5" || true; }
    if [ -n "$why" ]; then
      echo "$why" >"$STATE/guard-tripped"
      log "GUARD TRIP: $why"
      do_restore
      exit 0
    fi
    sleep 1
  done
}

do_readback() {
  expect=
  [ "${1:-}" != "--expect" ] || expect=${2:-}
  fail=0
  for u in $UNITS lhmc.slice; do
    v=$(systemctl show "$u" -p AllowedCPUs --value 2>/dev/null | tr " " "," || true)
    eff=$(cat "/sys/fs/cgroup/$u/cpuset.cpus.effective" 2>/dev/null || echo n/a)
    echo "AllowedCPUs $u=[$v] effective=[$eff]"
    case $expect in
      restored) [ -z "$v" ] || { echo "MISMATCH AllowedCPUs $u"; fail=1; } ;;
      I2|I3) case $u in lhmc.slice) want=$CCD1 ;; *) want=$CCD0 ;; esac
             [ "$v" = "$want" ] || { echo "MISMATCH AllowedCPUs $u want $want"; fail=1; } ;;
      I0|I1) [ -z "$v" ] || { echo "MISMATCH AllowedCPUs $u"; fail=1; } ;;
    esac
  done
  epp=$(for n in $(seq 0 23); do cat /sys/devices/system/cpu/cpu$n/cpufreq/energy_performance_preference; done | sort | uniq -c | awk '{printf "%s x%s ", $2, $1}')
  echo "EPP all-cpus: $epp"
  e1=$(for n in $(cpulist "$CCD1"); do cat /sys/devices/system/cpu/cpu$n/cpufreq/energy_performance_preference; done | sort -u | tr '\n' ' ')
  echo "EPP CCD1: $e1"
  boost=$(cat /sys/devices/system/cpu/cpufreq/boost)
  par=$(cat /proc/sys/kernel/perf_event_paranoid)
  ctrs=$(docker ps -a --format '{{.Names}}' --filter name=lhmc- 2>/dev/null | tr '\n' ' ')
  echo "boost=$boost perf_event_paranoid=$par lhmc_containers=[$ctrs]"
  case $expect in
    restored)
      [ "$epp" = "balance_performance x24 " ] || { echo "MISMATCH EPP"; fail=1; }
      [ "$boost" = 1 ] || { echo "MISMATCH boost"; fail=1; }
      [ "$par" = 3 ] || { echo "MISMATCH paranoid"; fail=1; }
      [ -z "$ctrs" ] || { echo "MISMATCH containers"; fail=1; } ;;
    I3)
      [ "$e1" = "performance " ] || { echo "MISMATCH EPP CCD1"; fail=1; }
      [ "$boost" = 0 ] || { echo "MISMATCH boost"; fail=1; } ;;
    I0|I1|I2)
      [ "$boost" = 1 ] || { echo "MISMATCH boost"; fail=1; } ;;
  esac
  [ "$fail" = 0 ] || { echo "READBACK FAIL"; return 1; }
  echo "READBACK OK${expect:+ ($expect)}"
}

case ${1:-} in
  --build|--version) build_id ;;
  apply) [ $# -ge 3 ] || { echo "usage: ctl apply <I> <L> [--perf]" >&2; exit 2; }; do_apply "$2" "$3" "${4:-}" ;;
  restore) do_restore ;;
  readback) shift; do_readback "$@" ;;
  guard) do_guard ;;
  abort) mkdir -p "$STATE"; touch "$STATE/abort"; log "abort requested"; do_restore ;;
  status) for f in guard-tripped abort guard.pid pre.env; do [ -e "$STATE/$f" ] && echo "$f: $(head -n 1 "$STATE/$f")" || echo "$f: -"; done ;;
  dropcache)
    [ "${LHMC_AFK:-}" = 1 ] || { echo "ctl: dropcache evicts the whole workstation page cache; set LHMC_AFK=1 inside an AFK window" >&2; exit 3; }
    log "OPERATION drop_caches (not restorable)"
    printf 'sync\necho 3 > /proc/sys/vm/drop_caches\n' | rootsh ;;
  *) echo "ctl: unknown command '${1:-}' (try --help)" >&2; exit 2 ;;
esac
