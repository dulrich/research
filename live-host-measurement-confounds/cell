#!/bin/sh
# cell - run one measurement cell: apply -> sampler -> class runs (measure.mjs) -> cell-env -> restore -> readback.
# usage: cell run --id <id> --iso <I0..I3> --load <L0..L4|Llive> --classes <k1,k2,...> --out <dir> [--seeds k1=N,k2=M,...] [--afk] [--pilot N]
# >>> shguard modes=exec (generated by shell-disposition-gate --guard; do not edit)
case $(realpath -- "$0" 2>/dev/null) in */'live-host-measurement-confounds/cell') _shguard_m='exec' ;; *) if [ "${SHGUARD_MODE-}" = 'pipe' ]; then _shguard_m='pipe'; else _shguard_m='source'; fi ;; esac
# shellcheck disable=SC2317
case $_shguard_m in
  exec) unset _shguard_m ;;
  *) printf '%s: refusing %s invocation (supports: exec; pipe callers set SHGUARD_MODE=pipe)\n' 'cell' "$_shguard_m" >&2; unset _shguard_m; return 1 2>/dev/null || exit 1 ;;
esac
# <<< shguard
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  echo "usage: cell run --id <id> --iso <I0|I1|I2|I3> --load <L0|L1|L2|L3|L4|Llive> --classes <k1,k2,k3,k3-120,k3s,k4-warm,k4-cold,k4-cold-local>"
  echo "                --out <dir> [--seeds k1=N,...] [--afk]"
  echo "       cell --help | --build | --version"
  echo "Applies the condition (ctl), starts the 0.5 s sampler, runs each class's frozen config through scripts/measure.mjs,"
  echo "writes <dir>/cell-env.json, then always restores (EXIT/INT/TERM trap) and reads the controls back. A guard trip,"
  echo "an abort or a signal writes <dir>/INVALID and the cell must be re-run whole. --afk exports LHMC_AFK=1 (needed by k4-cold)."
  echo "--pilot N runs a temporary copy of each config with N invocations and 1 warm-up round (pilot data, excluded from inference)."
  echo "Llive applies no load (the user's real activity). K1 runs with perf_event_paranoid=2 for the cell (K5)."
  exit 0
fi
set -eu


HERE=$(cd "$(dirname "$0")" && pwd)
case ${1:-} in
  --build|--version) exec "$HERE/ctl" --build ;;
  run) shift ;;
  *) echo "cell: unknown command '${1:-}' (try --help)" >&2; exit 2 ;;
esac
id=; iso=; load=; classes=; out=; seeds=; pilot=
while [ $# -gt 0 ]; do
  case $1 in
    --id) id=$2; shift 2 ;;
    --iso) iso=$2; shift 2 ;;
    --load) load=$2; shift 2 ;;
    --classes) classes=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    --seeds) seeds=$2; shift 2 ;;
    --afk) LHMC_AFK=1; export LHMC_AFK; shift ;;
    --pilot) pilot=$2; shift 2 ;;
    *) echo "cell: unknown option $1" >&2; exit 2 ;;
  esac
done
[ -n "$id" ] && [ -n "$iso" ] && [ -n "$load" ] && [ -n "$classes" ] && [ -n "$out" ] || { echo "cell: --id --iso --load --classes --out are required" >&2; exit 2; }
CTL=$HERE/ctl
ROOT=$(cd "$HERE/.." && pwd)
mkdir -p "$out"
out=$(cd "$out" && pwd)
cd "$ROOT"
cl() { echo "$(date +%Y-%m-%dT%H:%M:%S) $*" >>"$out/cell.log"; }
STATE=${LHMC_STATE:-$HERE/var/ctl}

case $iso in
  I0) PIN1=none; PIN2=""; PINK4=""; K1CFG=k1-unpinned ;;
  I1|I2|I3) PIN1=8; PIN2=6-11; PINK4=8; K1CFG=k1-pinned ;;
  *) echo "cell: bad isolation $iso" >&2; exit 2 ;;
esac
ctlload=$load; [ "$load" != Llive ] || ctlload=L0
perfarg=""
case ",$classes," in *,k1,*) perfarg=--perf ;; esac

sp=
status=ok
cleanup() {
  rc=$?
  trap - EXIT INT TERM
  [ -z "$sp" ] || kill "$sp" 2>/dev/null || true
  "$HERE/k1.sh" stop || true
  [ ! -e "$STATE/guard-tripped" ] || { status=invalid; cp "$STATE/guard-tripped" "$out/INVALID" 2>/dev/null || true; }
  [ "$rc" = 0 ] || status=invalid
  "$CTL" restore >>"$out/cell.log" 2>&1 || status=restore-failed
  "$CTL" readback --expect restored >"$out/readback-after.txt" 2>&1 || status=restore-failed
  [ "$status" = ok ] || { [ -e "$out/INVALID" ] || echo "$status rc=$rc" >"$out/INVALID"; }
  cl "end status=$status"
  tail -n 1 "$out/readback-after.txt"
  [ "$status" = ok ]
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

jstr() { printf '"%s"' "$(printf '%s' "$1" | tr -d '"\\' | tr '\n' ' ')"; }
cpufile() { cat "/sys/devices/system/cpu/cpu$1/cpufreq/$2" 2>/dev/null || echo NA; }
envjson() { # envjson <measured-cpu> <phase>
  c=$1
  printf '{"phase":%s,"time":%s,"cell":%s,"iso":%s,"load":%s,"measured_cpu":%s,' "$(jstr "$2")" "$(jstr "$(date +%Y-%m-%dT%H:%M:%S)")" "$(jstr "$id")" "$(jstr "$iso")" "$(jstr "$load")" "$c"
  printf '"governor":%s,"epp":%s,"scaling_cur_freq_khz":%s,"boost":%s,"perf_event_paranoid":%s,' \
    "$(jstr "$(cpufile "$c" scaling_governor)")" "$(jstr "$(cpufile "$c" energy_performance_preference)")" "$(jstr "$(cpufile "$c" scaling_cur_freq)")" \
    "$(jstr "$(cat /sys/devices/system/cpu/cpufreq/boost)")" "$(jstr "$(cat /proc/sys/kernel/perf_event_paranoid)")"
  printf '"epp_ccd1":%s,"readback":%s,' "$(jstr "$(for n in 6 7 8 9 10 11 18 19 20 21 22 23; do cpufile "$n" energy_performance_preference; done | sort | uniq -c | tr -s ' ' | tr '\n' ';')")" "$(jstr "$("$CTL" readback 2>&1 | tr '\n' '|')")"
  printf '"driver_shell_cpus_allowed":%s,' "$(jstr "$(awk '/^Cpus_allowed_list/{print $2}' /proc/self/status)")"
  printf '"cpuset_probes":{'
  first=1
  for cls in $(echo "$classes" | tr ',' ' '); do
    case $cls in k1) pin=$PIN1 ;; k2|k3|k3-120|k3s) pin=$PIN2 ;; *) pin=$PINK4 ;; esac
    [ "$pin" != none ] || pin=""
    pinarg=""; [ -z "$pin" ] || pinarg="--cpuset-cpus $pin"
    # shellcheck disable=SC2086
    probe=$(docker run --rm --cgroup-parent lhmc.slice $pinarg lhmc-bench sh -c 'printf "Cpus_allowed_list=%s cgroup_cpuset_effective=%s" "$(awk "/^Cpus_allowed_list/{print \$2}" /proc/self/status)" "$(cat /sys/fs/cgroup/cpuset.cpus.effective)"' 2>&1 || true)
    [ "$first" = 1 ] || printf ','
    first=0
    printf '%s:%s' "$(jstr "$cls")" "$(jstr "requested=[$pin] $probe")"
  done
  printf '},"antagonists":['
  first=1
  for n in $(docker ps --filter label=lhmc=load --format '{{.Names}}' 2>/dev/null); do
    p=$(docker inspect -f '{{.State.Pid}}' "$n")
    cg=$(sed -n 's/^0:://p' "/proc/$p/cgroup")
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"name":%s,"cpus_allowed":%s,"cgroup_cpuset_effective":%s}' "$(jstr "$n")" "$(jstr "$(awk '/^Cpus_allowed_list/{print $2}' "/proc/$p/status")")" "$(jstr "$(cat "/sys/fs/cgroup$cg/cpuset.cpus.effective" 2>/dev/null || echo NA)")"
  done
  printf ']}\n'
}

mkdir -p "$out"
cl "begin cell=$id iso=$iso load=$load classes=$classes"
"$CTL" readback >"$out/readback-before.txt" 2>&1 || true
# shellcheck disable=SC2086
"$CTL" apply "$iso" "$ctlload" $perfarg >>"$out/cell.log" 2>&1
"$CTL" readback >"$out/readback-applied.txt" 2>&1 || true
mcpu=8
taskset -c 0-5,12-17 "$HERE/sampler.sh" "$out/sampler.tsv" "$mcpu" &
sp=$!
envjson "$mcpu" start >"$out/cell-env.json"
for cls in $(echo "$classes" | tr ',' ' '); do
  [ ! -e "$STATE/guard-tripped" ] || { cl "guard tripped: $(cat "$STATE/guard-tripped"); aborting"; exit 1; }
  seed=$(echo ",$seeds," | sed -n "s/.*,$cls=\([0-9]*\),.*/\1/p")
  seedarg=""; [ -z "$seed" ] || seedarg="--seed $seed"
  cfg=$cls; [ "$cls" != k1 ] || cfg=$K1CFG
  t0=$(date +%s)
  case $cls in
    k1)
      "$HERE/k1.sh" start "$PIN1"; "$HERE/k1.sh" warm ;;
    k2|k3|k3-120|k3s) LHMC_PIN=$PIN2; export LHMC_PIN ;;
    *) LHMC_PIN=$PINK4; export LHMC_PIN ;;
  esac
  [ "$cls" != k1 ] || { LHMC_PIN=$PIN1; [ "$PIN1" != none ] || LHMC_PIN=""; export LHMC_PIN; }
  cl "class $cls config=$cfg seed=${seed:-config} start"
  mkdir -p "$out/$cls"
  cfgpath=live-host-measurement-confounds/configs/$cfg.json
  if [ -n "$pilot" ]; then
    bun -e 'const f = process.argv[1]; const c = JSON.parse(require("fs").readFileSync(f, "utf8")); c.invocations = +process.argv[2]; c.warmup = 1; require("fs").writeFileSync(process.argv[3], JSON.stringify(c))' "$cfgpath" "$pilot" "$out/$cls/pilot-config.json"
    cfgpath=$out/$cls/pilot-config.json
  fi
  # shellcheck disable=SC2086
  if bun scripts/measure.mjs run --config "$cfgpath" --out "$out/$cls" $seedarg >"$out/$cls/driver.out" 2>&1; then r=0; else r=$?; fi
  sha256sum "$cfgpath" | cut -d' ' -f1 >"$out/$cls/config.sha256"
  [ "$cls" != k1 ] || "$HERE/k1.sh" stop
  t1=$(date +%s)
  cl "class $cls exit=$r wall_s=$((t1 - t0))"
  printf '%s\t%s\t%s\n' "$cls" "$r" "$((t1 - t0))" >>"$out/walls.tsv"
  [ "$r" = 0 ] || { echo "class $cls failed (exit $r)" >>"$out/INVALID"; status=class-failed; }
done
envjson "$mcpu" end >"$out/cell-env-end.json"
[ "$status" = ok ] || exit 1
exit 0
