+/// The survey's statement as written: anything `write_message` accepts, `read_message` accepts.
+proof fn writer_reader_agree_as_written(body: Seq<u8>)
+    requires write_accepts(body),
+    ensures read_spec(frame(body)) is Ok,
+{
+    lemma_le4(body.len());
+    assert(frame(body).subrange(0, 4) =~= le4(body.len()));
+    assert(frame(body).subrange(4, 4 + body.len() as int) =~= body);
+}
+
