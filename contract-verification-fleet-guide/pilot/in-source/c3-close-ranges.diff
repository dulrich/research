+/// Range `p` (inclusive) contains descriptor `fd`.
+pub open spec fn in_range(p: (u32, u32), fd: u32) -> bool {
+    p.0 <= fd <= p.1
+}
+
+/// `fd` is the descriptor to keep: `keep` names it and it is not stdio.
+pub open spec fn kept(keep: Option<RawFd>, fd: u32) -> bool {
+    keep is Some && keep->0 >= 3 && fd == keep->0 as u32
+}
+
+/// Some range contains `fd`.
+pub open spec fn covered(s: Seq<(u32, u32)>, fd: u32) -> bool {
+    exists|i: int| 0 <= i < s.len() && #[trigger] in_range(s[i], fd)
+}
+
+/// Exactly one range contains `fd`.
+pub open spec fn covered_once(s: Seq<(u32, u32)>, fd: u32) -> bool {
+    exists|i: int| 0 <= i < s.len() && #[trigger] in_range(s[i], fd)
+        && forall|j: int| 0 <= j < s.len() && j != i ==> !#[trigger] in_range(s[j], fd)
+}
