+/// The ranges `close_ranges` returns, as a model.
+pub open spec fn ranges_model(keep: Option<RawFd>) -> Seq<(u32, u32)> {
+    if keep is Some && keep->0 > 3 {
+        seq![(3u32, (keep->0 - 1) as u32), ((keep->0 + 1) as u32, u32::MAX)]
+    } else if keep == Some(3i32) {
+        seq![(4u32, u32::MAX)]
+    } else {
+        seq![(3u32, u32::MAX)]
+    }
+}
