+#[cfg(verus_keep_ghost)]
+verus! {
+
+/// Whether `handle` has a match arm for this (state, event) pair other than the final `_`.
+pub open spec fn has_arm(s: State, e: Event) -> bool {
+    match (s, e) {
+        (State::Username, Event::Submit(_)) => true,
+        (State::Prompt { .. }, Event::Submit(_)) => true,
+        (State::Prompt { .. }, Event::Escape) => true,
+        (State::Authenticating, Event::Response(_)) => true,
+        (State::Starting, Event::Response(Response::Success)) => true,
+        (State::Starting, Event::Response(Response::Error { .. })) => true,
+        (State::Cancelling, Event::Response(_)) => true,
+        _ => false,
+    }
+}
+
+// Assumed, not proved: the derived `Clone` of `State` returns an equal value (its fields are
+// `String` and `bool`).
+pub assume_specification[ <State as Clone>::clone ](s: &State) -> (r: State)
+    ensures r == *s;
+
+impl LoginMachine {
+    pub closed spec fn spec_state(&self) -> State { self.state }
+    pub closed spec fn spec_message(&self) -> Option<String> { self.message }
+    pub closed spec fn spec_cmd(&self) -> Vec<String> { self.cmd }
+}
+
+/// A session start is requested only after an accepted authentication, and moves to `Starting`.
+pub open spec fn c2_start_only_after_auth(pre: LoginMachine, e: Event, post: LoginMachine, r: Output) -> bool {
+    r.request matches Some(Request::StartSession { .. }) ==>
+        pre.spec_state() is Authenticating && e == Event::Response(Response::Success) && post.spec_state() is Starting
+}
+
+/// A session start carries exactly the configured command (element-wise; see the clone note).
+pub open spec fn c2_start_carries_cmd(pre: LoginMachine, r: Output) -> bool {
+    r.request matches Some(Request::StartSession { cmd, .. }) ==>
+        vstd::view::View::view(&cmd) == vstd::view::View::view(&pre.spec_cmd())
+}
+
+/// `Done` is entered only from `Starting` on `Success`.
+pub open spec fn c2_done_only_from_starting(pre: LoginMachine, e: Event, post: LoginMachine, r: Output) -> bool {
+    post.spec_state() is Done ==> pre.spec_state() is Done
+        || (pre.spec_state() is Starting && e == Event::Response(Response::Success))
+}
+
+/// A submitted answer leaves only from `Prompt` on `Submit`, and it is exactly the submitted answer.
+pub open spec fn c2_answer_only_from_prompt(pre: LoginMachine, e: Event, post: LoginMachine, r: Output) -> bool {
+    r.request matches Some(Request::PostAuthMessageResponse { response: Some(a) }) ==>
+        pre.spec_state() is Prompt && e == Event::Submit(a)
+}
+
+/// An event with no matching arm emits nothing and changes neither the state nor the message.
+pub open spec fn c2_no_arm_no_effect(pre: LoginMachine, e: Event, post: LoginMachine, r: Output) -> bool {
+    !has_arm(pre.spec_state(), e) ==>
+        r.request is None && post.spec_state() == pre.spec_state() && post.spec_message() == pre.spec_message()
+}
+
+} // verus!
